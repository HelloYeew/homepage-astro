---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import "../styles/global.css";
---

<Layout title="About | HelloYeew" transparentHeader={true} lockScroll={true}>
    <div class="w-full h-screen">
        <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 items-center">
            <div class="flex-none lg:flex gap-3 my-3">
                <h1 class="text-5xl font-bold pb-6">Phawit Pornwattanakul</h1>
                <h1 class="text-3xl font-normal">(HelloYeew, Folk)</h1>
            </div>
            <div class="flex-none lg:flex gap-6">
                <Image src={"/profile.webp"} alt="HelloYeew" class="w-full h-full max-w-72 max-h-72 rounded-full" width={128} height={128} />
                <div class="flex flex-col">
                    <div class="p-3">
                        <ul class="text-xl lg:text-3xl">
                            <li class="my-2">💼 Full-Stack Software Engineer</li>
                            <li class="my-2">💡 Web, low-level computer graphic</li>
                            <li class="my-2">💻 Open-source, personal project, personal tools</li>
                            <li class="my-2">❤️ Music, Anime, Cosplay</li>
                        </ul>
                    </div>
                    <div class="p-3">
                        <a class="text-3xl underline" href="https://resume.helloyeew.dev">Resume</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>
