---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
	const posts = await getCollection('journey');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}
type Props = CollectionEntry<'journey'>;

const post = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title + ' | HelloYeew'}>
	<div class="container mx-auto max-w-5xl p-3">
		<div class="w-full max-h-96 overflow-hidden rounded-lg">
			<img class="w-full" src={post.data.heroImage} alt={post.data.title} />
		</div>
		<article class="prose lg:prose-xl w-full py-3">
			<h1 class="py-3">{post.data.title}</h1>
			<p class="text-neutral">{post.data.pubDate.toLocaleDateString}</p>
			<Content />
		</article>
	</div>
</Layout>
