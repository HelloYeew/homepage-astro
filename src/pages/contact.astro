---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
---

<Layout title="Contact | HelloYeew" transparentHeader={true} lockScroll={true} floatHeader={true}>
    <div class="w-full h-screen">
        <!--<Image src="/home.jpeg" alt="" class="w-full h-full object-cover" width={1920} height={1080} />-->
        <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 items-center flex-none lg:flex gap-3 my-3">
            <div class="m-5 bg-base-300 bg-opacity-75 p-5 rounded-lg">
                <div class="flex-none lg:flex gap-3 my-3">
                    <h1 class="text-5xl font-bold pb-6">Let's know more!</h1>
                </div>
                <div class="flex-none lg:flex gap-6">
                    <div class="p-3">
                        <ul class="text-3xl">
                            <li class="my-2">Email: <a href="mailto:me@helloyeew.dev" class="underline">me@helloyeew.dev</a></li>
                            <li class="my-2">Discord: <a href="https://discordapp.com/users/366066360075288577" class="underline">helloyeew</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="m-5 bg-base-300 bg-opacity-75 p-5 rounded-lg">
                <div class="flex-none lg:flex gap-3 my-3">
                    <h1 class="text-5xl font-bold pb-6">Follow me</h1>
                </div>
                <div class="flex-none lg:flex gap-6">
                    <div class="p-3">
                        <ul class="text-3xl">
                            <li class="my-2"><a href="https://github.com/HelloYeew" class="underline">GitHub</a></li>
                            <li class="my-2"><a href="https://facebook.com/HelloYeew" class="underline">Facebook</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>
