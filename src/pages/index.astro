---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import "../styles/global.css";
---

<Layout title="HelloYeew" transparentHeader={true} lockScroll={true} floatHeader={true}>
    <div class="w-full h-screen">
        <Image src="/home.webp" alt="" class="w-auto min-w-full h-auto min-h-full object-cover" width={1920} height={1080} />
        <div class="absolute bottom-0 right-0 m-4 p-4 bg-black/60 text-white rounded-xl">
            <p class="font-bold">Monica Everett</p>
            <p>Silent Witch</p>
            <p class="text-gray-300">Ayutthaya, Thailand</p>
            <p class="text-gray-300">25 December 2025 04:22:54 PM</p>
            <p class="text-gray-300">📸 <a href="https://www.facebook.com/CameMarkPhotographer" class="underline">CameMark & CameSara</a></p>
        </div>
    </div>
</Layout>
