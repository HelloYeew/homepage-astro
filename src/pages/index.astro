        <Image src="/home.webp" alt="" class="w-auto min-w-full h-auto min-h-full object-cover" width={1920} height={1080} />
        <div class="absolute bottom-0 right-0 m-4 p-4 bg-black bg-opacity-60 text-white rounded-xl">
            <p class="font-bold">Rafayel</p>
            <p>Love and Deepspace</p>
            <p class="text-gray-300">Pattaya, Chonburi, Thailand</p>
            <p class="text-gray-300">22 February 2025 06:33:49 PM</p>
            <p class="text-gray-300">📸 <a href="https://www.facebook.com/nitikorn.lakorn" class="underline">Nitikorn Lakorn</a></p>
        </div>
    </div>
</Layout>
