---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
---

<Layout title="HelloYeew" transparentHeader={true} lockScroll={true} floatHeader={true}>
    <div class="w-full h-screen">
        <Image src="/home.jpeg" alt="" class="w-full h-full object-cover" width={1920} height={1080} />
        <div class="absolute bottom-0 right-0 m-4 p-4 bg-black bg-opacity-60 text-white rounded-xl">
            <p class="font-bold">Aether Bunny ver.</p>
            <p>Genshin Impact</p>
            <p class="text-gray-300">CAF 2024 @ ICONSIAM</p>
            <p class="text-gray-300">21 July 2024 04:30:19 PM</p>
            <p class="text-gray-300">Photos By <a href="https://www.facebook.com/CameMarkPhotographer" class="underline">CameMark & CameSara</a></p>
        </div>
    </div>
</Layout>
